# PostgreSQL Database Connection URL for Server & Sync (Phase 3)
DATABASE_URL=postgresql://pos:pos_dev_secret@localhost:5432/pos_server

# Optional individual Postgres container environment variables (used by docker-compose)
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos_dev_secret
POSTGRES_DB=pos_server
POSTGRES_PORT=5432

# Server Port & Host
PORT=3000
HOST=0.0.0.0
